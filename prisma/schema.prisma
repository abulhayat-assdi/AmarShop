// AmarShop — Prisma schema
//
// Multi-tenancy model: schema-per-tenant (spec §4).
//   - The `public` schema holds global data. Prisma manages it (models below).
//   - Each tenant gets its own `tenant_<x>` schema, provisioned and migrated by
//     the custom SQL runner in src/lib/tenant/ (Prisma does NOT manage those).
//
// Module 2 scope: the global auth/tenant models needed for sign-up, login, and
// tenant provisioning. RBAC (staff/permissions/audit), subscriptions, feature
// flags, and payment tables arrive in their respective later modules.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: connection URLs live in `prisma.config.ts` (for Migrate) and are
  // passed to PrismaClient via a driver adapter at runtime (see src/lib/prisma.ts).
}

/// Application-wide roles. `admin`/`editor` are super-admin staff roles whose
/// granular permissions are managed in the RBAC module (spec §6.7).
enum UserRole {
  user
  super_admin
  admin
  editor
}

/// Lifecycle state of a tenant's site.
enum TenantStatus {
  active
  suspended
  trial
}

/// Category of site a tenant runs (e-commerce is the primary focus, spec §1).
enum SiteType {
  ecommerce
  blog
  portfolio
  agency
  landing
}

/// A platform account. A tenant owner has `tenantId` set; the super-admin (and
/// its staff) have no tenant. One owner account maps to one tenant by default
/// (spec §6.4); additional staff users can share a tenant later.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole @default(user)
  tenantId     String?  @map("tenant_id")
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("users")
}

/// A customer's site. `schemaName` points at the dedicated PostgreSQL schema
/// that holds this tenant's data (products, orders, ...).
model Tenant {
  id                 String       @id @default(cuid())
  name               String
  subdomain          String       @unique
  customDomain       String?      @unique @map("custom_domain")
  schemaName         String       @unique @map("schema_name")
  status             TenantStatus @default(trial)
  planId             String?      @map("plan_id")
  plan               Plan?        @relation(fields: [planId], references: [id])
  siteType           SiteType     @default(ecommerce) @map("site_type")
  ownGatewayApproved Boolean      @default(false) @map("own_gateway_approved")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  users    User[]
  features TenantFeature[]

  @@index([planId])
  @@map("tenants")
}

/// Per-tenant feature flag (spec §6.5). Enforcement (`hasFeature`) is wired in;
/// plan-based auto-assignment is refined in Phase 2.
model TenantFeature {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  featureKey String   @map("feature_key")
  enabled    Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, featureKey])
  @@map("tenant_features")
}

/// A master template = a read-only blueprint (spec §5.6). Selecting one deep-
/// copies its `structureJson` (blocks) into the tenant's `site_config`.
model Template {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  category        String
  siteType        SiteType @map("site_type")
  structureJson   Json     @map("structure_json")
  defaultDataJson Json     @default("{}") @map("default_data_json")
  previewUrl      String?  @map("preview_url")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([siteType])
  @@index([category])
  @@map("templates")
}

/// Subscription tier. Prices are placeholders until finalized (spec §13);
/// `price` is stored in the smallest currency unit (poisha).
model Plan {
  id        String   @id @default(cuid())
  name      String   @unique
  price     Int      @default(0)
  maxSites  Int      @default(1) @map("max_sites")
  features  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  tenants Tenant[]

  @@map("plans")
}
