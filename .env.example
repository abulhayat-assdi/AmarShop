# ============================================================
# AmarShop — Environment Variables (example)
# Copy this file to `.env` and adjust for your machine.
# NEVER commit the real `.env` file.
#
# When running via docker compose, DATABASE_URL / DIRECT_URL / REDIS_URL are
# overridden to the compose service hostnames (see docker-compose.yml).
# The localhost values below are for running the app outside Docker.
# ============================================================

# Node environment: development | test | production
NODE_ENV=development

# --- Datastore credentials (consumed by docker-compose.yml) ---
# Local defaults below are fine for development. In staging/production, provide
# strong, distinct values (e.g. via Coolify secrets) — never ship these.
POSTGRES_USER=amarshop
POSTGRES_PASSWORD=amarshop
POSTGRES_DB=amarshop
REDIS_PASSWORD=amarshop

# --- Database (PostgreSQL via PgBouncer) ---
# Pooled connection used by the app at runtime (through PgBouncer, port 6432).
# With the Prisma 7 pg driver adapter, the schema is chosen by the adapter (not
# the URL), and transaction-mode pooling is safe because node-postgres uses
# unnamed prepared statements — no legacy `?pgbouncer=true` flag is needed.
DATABASE_URL="postgresql://amarshop:amarshop@localhost:6432/amarshop"
# Direct connection used ONLY by Prisma Migrate (bypasses PgBouncer, port 5432).
DIRECT_URL="postgresql://amarshop:amarshop@localhost:5432/amarshop"

# --- Redis (cache + BullMQ queues) ---
REDIS_URL="redis://:amarshop@localhost:6379"

# --- Application ---
# Public base URL of the platform.
APP_URL="http://localhost:3000"
# Root domain for tenant subdomains (e.g. shop.amarshop.com).
ROOT_DOMAIN="localhost:3000"

# --- Auth (NextAuth / Auth.js) ---
# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-generate-a-strong-secret"

# --- Super-admin bootstrap (consumed by `npm run db:seed`) ---
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="change-me-strong-password"

# --- Self-hosted file storage (spec §7.1) ---
# Directory for uploaded images. Defaults to <project>/uploads if unset;
# docker-compose sets it to /app/uploads (a persistent volume).
# UPLOAD_DIR="/app/uploads"

# --- Cloudflare R2 backup (spec §7.1, §8) — used by scripts/backup.sh ---
# R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
# R2_BUCKET="amarshop-backups"
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""

# --- Payments (spec §6.2) ---
# Key to encrypt gateway credentials at rest (min 16 chars). Generate with:
# openssl rand -base64 32
ENCRYPTION_KEY="change-me-generate-a-strong-32-byte-key"
